# ============================================================
#   IoT Medicare Platform — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
.installed.cfg
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.spec

# ── Virtual Environments ────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment / Secrets ───────────────────────────────────
.env
.env.*
!.env.example

# ── Local Database (SQLite fallback) ────────────────────────
database/*.db
database/*.db-shm
database/*.db-wal
*.sqlite3
*.sqlite

# ── Flask / Werkzeug ────────────────────────────────────────
instance/
.webassets-cache
flask_session/

# ── ML / Pickle model artifacts ─────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.model
ml/models/

# ── Notebooks ────────────────────────────────────────────────
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
server_log.txt

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.coveragerc

# ── IDEs / Editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Vercel ──────────────────────────────────────────────────
.vercel/

# ── Android Studio / Gradle ─────────────────────────────────
*.iml
.gradle/
local.properties
.idea/
*.ap_
*.apk
*.aab
*.dex
*.class
bin/
gen/
out/
release/
app/release/
app/debug/
app/build/
build/
captures/
*.jks
*.keystore
!debug.keystore
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/gradle/
.externalNativeBuild/
.cxx/
*.hprof
google-services.json

# ── Node (if any frontend build step) ───────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── Temporary / OS Files ────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
.cache/
