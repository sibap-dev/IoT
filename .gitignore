# ============================================================
#   IoT Medicare Platform — .gitignore
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual Environments ────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment / Secrets ───────────────────────────────────
.env
.env.*
!.env.example

# ── Local Database ──────────────────────────────────────────
database/*.db
database/*.db-shm
database/*.db-wal
*.sqlite3
*.sqlite

# ── Flask / Werkzeug ────────────────────────────────────────
instance/
.webassets-cache
flask_session/

# ── LARGE ML FILES — Do NOT commit ──────────────────────────
# machinL/ has 830MB zip + joblib files — served from HuggingFace
machinL/

# ml/models/ — auto-regenerated at runtime (Isolation Forest)
ml/models/

# ml_service/models/ — already on HuggingFace Spaces, not needed here
ml_service/models/

# ── Binary model / data artefacts ───────────────────────────
*.joblib
*.pkl
*.pickle
*.h5
*.pth
*.pt
*.onnx
*.zip

# ── Local SQLite database ───────────────────────────────────
*.db

# ── Jupyter Notebooks ───────────────────────────────────────
*.ipynb
.ipynb_checkpoints/

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
server_log.txt

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ── IDEs / Editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Vercel ──────────────────────────────────────────────────
.vercel/

# ── Node ────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ── Temp / OS ────────────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
.cache/
